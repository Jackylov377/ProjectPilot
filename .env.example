# Copy to .env and set your own key locally. Never commit .env.
PROJECTPILOT_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
PROJECTPILOT_MODEL=qwen3.8-flash
PROJECTPILOT_API_KEY=

# Optional advanced knowledge retrieval (live mode only).
# Selected document chunks and queries are sent to these explicitly configured services.
# OpenAI-compatible embeddings endpoint; credentials are not inherited from generation.
PROJECTPILOT_EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
PROJECTPILOT_EMBEDDING_MODEL=text-embedding-v4
PROJECTPILOT_EMBEDDING_DIMENSIONS=256
PROJECTPILOT_EMBEDDING_API_KEY=
# Optional DashScope-compatible rerank endpoint (only for hybrid_rerank).
PROJECTPILOT_RERANK_API_BASE=https://dashscope.aliyuncs.com
PROJECTPILOT_RERANK_MODEL=gte-rerank-v2
PROJECTPILOT_RERANK_API_KEY=
