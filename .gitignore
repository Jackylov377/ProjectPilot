# Publish only application files and the resources needed to run them.
/*
!/.gitignore
!/.dockerignore
!/.env.example
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/pyproject.toml
!/Dockerfile
!/compose.yaml
!/app/
!/licenses/

!/scripts/
/scripts/*
!/scripts/prepare_tokenizer.py
!/scripts/inventory_workspace.py

!/examples/
/examples/*
!/examples/demo_project/

!/evals/
/evals/*
!/evals/datasets/
/evals/datasets/*
!/evals/datasets/agent_dev/
/evals/datasets/agent_dev/*
!/evals/datasets/agent_dev/tasks_v2.json

# Do not publish generated state or credentials inside allowed directories.
__pycache__/
*.py[cod]
*.egg-info/
*.log
*.sqlite
*.sqlite3
*.sqlite3-*
*.db
*.pem
*.key
*.p12
*.pfx
.env
.env.*
!.env.example
