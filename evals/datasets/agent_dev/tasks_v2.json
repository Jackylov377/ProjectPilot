{
  "dataset_version": "agent-dev-v2",
  "split": "development",
  "description": "30 synthetic development tasks. All are seen development tasks, never held-out acceptance. Scripted offline responses do not measure model quality.",
  "budget": {
    "timeout_seconds": 45,
    "max_iterations": 10,
    "window_tokens": 16384,
    "recent_turns": 4,
    "max_output_tokens": 1024
  },
  "cases": [
    {
      "case_id": "note-read",
      "tags": [
        "normal",
        "tool"
      ],
      "engine": "session",
      "files": {
        "overview.md": "项目 Atlas 用于整理实验记录，当前阶段是离线归档。\n"
      },
      "turns": [
        {
          "prompt": "请读取 overview，说明 Atlas 项目的用途，并引用文件名。",
          "checks": {
            "contains": [
              "Atlas",
              "实验记录",
              "overview.md"
            ],
            "required_tools": [
              "read_project_note"
            ]
          }
        }
      ],
      "objective": "Read and cite the overview."
    },
    {
      "case_id": "note-missing",
      "tags": [
        "tool_fault",
        "honest_failure"
      ],
      "engine": "session",
      "files": {},
      "turns": [
        {
          "prompt": "请用 read_project_note 读取 overview 并介绍项目；如工具读取失败，请明确说明无法确认。",
          "checks": {
            "any_of": [
              [
                "无法确认",
                "无法读取",
                "读取失败"
              ]
            ],
            "tool_error": true
          }
        }
      ],
      "objective": "Disclose a missing source without invention."
    },
