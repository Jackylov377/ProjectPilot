              "search_knowledge"
            ],
            "min_restored_messages": 2,
            "retrieval": {
              "k": 3,
              "relevant": [
                {
                  "source": "schedule.txt",
                  "start_line": 1,
                  "end_line": 1
                }
              ]
            }
          }
        }
      ],
      "objective": "Re-read updated documents in the same session."
    },
    {
      "case_id": "memory-model-change",
      "tags": [
        "memory_conflict",
        "cross_session"
      ],
      "engine": "session",
      "memory": true,
      "files": {},
      "turns": [
        {
          "session": "decision-a",
          "prompt": "我们这个项目决定使用模型 A。",
          "checks": {
            "contains": [
              "模型 A"
            ],
            "active_memory": {
              "project.model": "模型 A"
            },
            "recalled_memory": {
              "project.model": "模型 A"
            }
          }
        },
        {
          "session": "decision-b",
          "prompt": "我们决定放弃模型 A，改用模型 B。",
          "checks": {
            "contains": [
              "模型 B"
            ],
            "excludes": [
              "模型 A"
            ],
            "active_memory": {
              "project.model": "模型 B"
            },
            "recalled_memory": {
              "project.model": "模型 B"
            }
          }
        },
        {
          "session": "recall",
          "prompt": "当前项目模型方案是什么？请说明来源会话。",
          "checks": {
            "contains": [
              "模型 B",
              "decision-b"
            ],
            "excludes": [
              "模型 A"
            ],
            "active_memory": {
              "project.model": "模型 B"
            },
            "recalled_memory": {
              "project.model": "模型 B"
            }
          }
        }
      ],
      "objective": "Replace A with B and recall B in a new session."
    },
    {
      "case_id": "repository-report",
      "tags": [
        "complex",
        "multi_step",
        "report"
      ],
      "engine": "repository",
      "files": {
        "README.md": "# Harbor\nHarbor 计算已批准的物料总数。入口是 main.py，核心规则在 core.py。\n使用 python main.py 运行。\n",
        "core.py": "def approved_total(rows):\n    return sum(row['count'] for row in rows if row['approved'])\n",
        "main.py": "from core import approved_total\n\nif __name__ == '__main__':\n    print(approved_total([{'count': 3, 'approved': True}]))\n"
      },
      "human_review": "核对报告准确描述入口、批准条件和求和行为；保存成功和关键词命中不等于分析正确。",
      "turns": [
        {
          "prompt": "分析 Harbor 的用途、入口和核心规则，引用文件行号，并保存一份 Markdown 报告。",
          "checks": {
            "required_tools": [
              "list_files",
              "read_file",
              "search_code",
              "write_report"
            ],
            "report_contains": [
              "README.md:",
              "core.py:",
              "approved_total"
            ]
          }
        }
      ],
      "objective": "Read code and persist a supported report."
    },
