              "calibration.txt:"
            ],
            "required_tools": [
              "search_knowledge"
            ],
            "retrieval": {
              "k": 3,
              "relevant": [
                {
                  "source": "calibration.txt",
                  "start_line": 1,
                  "end_line": 1
                }
              ]
            }
          }
        }
      ],
      "objective": "Retrieve and cite the calibration interval."
    },
